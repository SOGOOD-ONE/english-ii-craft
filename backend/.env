# Django SECRET_KEY 开发阶段兜底: 生产请通过环境变量覆盖
SECRET_KEY=django-insecure-LOCAL_DEV_ONLY_change-me-please
# 本地开发默认 DEBUG=True
DEBUG=True
# CORS 允许前端 5173 / TRAE 预览 / Vercel 预览
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF 同源
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 可选:覆盖全局智谱 Key(用户未设置自己的 Key 时)
# 留空: 写 essay_review / word_lookup 会返回 400「请先在设置页填入 Key 或由管理员配置全局 Key」
GLOBAL_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLOBAL_AI_API_KEY=
GLOBAL_AI_MODEL=glm-4-flash
# SQLite 文件路径(相对 BASE_DIR / backend/): 生产用 DATABASE_URL
DATABASE_NAME=db.sqlite3
